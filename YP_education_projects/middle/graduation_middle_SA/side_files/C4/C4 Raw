workspace "Ритм: Платформа для трекинга спортивной активности" {

  model {

    // ------------------------------------------------------------
    // Пользователи и внешние участники
    // ------------------------------------------------------------

    user = person "Пользователь" {
      description "Спортсмен-любитель"
    }

    admin = person "Администратор" {
      description "Сотрудник поддержки или модерации"
    }

    partner = person "Партнёр / корпоративный клиент" {
      description "Потенциальный внешний партнёр"
    }

    // ------------------------------------------------------------
    // Внешние системы
    // ------------------------------------------------------------

    oauthProviders = softwareSystem "OAuth-провайдеры" {
      description "Внешние провайдеры авторизации: Google, Apple, VK. Используются для входа пользователя через сторонний аккаунт"
    }

    pushServices = softwareSystem "Сервисы уведомлений" {
      description "Используются для доставки push-уведомлений пользователям"
    }

    mapServices = softwareSystem "Картографические сервисы" {
      description "Google Maps / OpenStreetMap. Используются для отображения карт, маршрутов и GPS-треков тренировок"
    }

    fitnessDevices = softwareSystem "Фитнес-устройства и внешние трекеры" {
      description "Garmin, Suunto, Apple Watch и др"
    }

    emailService = softwareSystem "Email-сервис" {
      description "Внешний сервис отправки email-сообщений для восстановления доступа и системных уведомлений"
    }

    // ------------------------------------------------------------
    // Граница компании
    // ------------------------------------------------------------

    group "Компания «Rhythm Production»" {

      ritm = softwareSystem "Платформа «Ритм»" {
        description "Социальная платформа для трекинга спортивной активности. Позволяет фиксировать тренировки, хранить историю, анализировать статистику и делиться результатами с подписчиками"

        // ------------------------------------------------------------
        // Клиентские приложения
        // ------------------------------------------------------------

        mobileApp = container "Мобильное приложение" {
          description "Основной клиентский интерфейс. Позволяет фиксировать GPS-трек, создавать и завершать тренировки, смотреть ленту, статистику и уведомления"
          technology "iOS / Android"
        }

        webApp = container "Веб-клиент" {
          description "Веб-интерфейс пользователя для просмотра профиля, истории тренировок, статистики, ленты, комментариев и реакций"
        }

        adminApp = container "Панель администратора" {
          description "Интерфейс администрирования и модерации: просмотр нарушений, скрытие активностей, блокировка пользователей"
        }

        // ------------------------------------------------------------
        // API-слой
        // ------------------------------------------------------------

        apiGateway = container "API Gateway" {
          description "Единая точка входа для мобильного приложения, веб-клиента, админки и будущих партнёрских интеграций. Выполняет маршрутизацию запросов, проверку токенов и агрегацию ответов"
        }

        // ------------------------------------------------------------
        // Доменные сервисы
        // ------------------------------------------------------------

        authService = container "Сервис Авторизации" {
          description "Сервис регистрации, входа, выхода, проверки токена доступа и интеграции с OAuth-провайдерами"
        }

        userService = container "Сервис Профиля" {
          description "Сервис управления профилями пользователей: просмотр, редактирование, настройки приватности, удаление аккаунта"
        }

        activityService = container "Сервис Активностей" {
          description "Сервис управления тренировками: создание активности, завершение активности, загрузка GPX-файлов, хранение GPS-треков, расчёт базовых метрик и управление видимостью"

          // ------------------------------------------------------------
          // Компоненты Activity Service — C4 Level 3
          // ------------------------------------------------------------

            activityController = component "Контроллер тренировок" {
                description "Принимает запросы от API Gateway: создать тренировку, завершить тренировку, посмотреть тренировку, изменить видимость или удалить тренировку"
            }
            
            activityManager = component "Управление тренировками" {
                description "Выполняет основную бизнес-логику: создаёт тренировку, завершает её, проверяет владельца, меняет видимость и передаёт данные на сохранение"
            }
            
            trackProcessor = component "Обработка GPS-трека" {
                description "Обрабатывает GPS-точки или GPX-файл, проверяет корректность маршрута и подготавливает данные трека для сохранения"
            }
            
            metricsCalculator = component "Расчёт показателей" {
                description "Рассчитывает дистанцию, время, темп, среднюю скорость и набор высоты по данным тренировки"
            }
            
            activityStorage = component "Хранилище тренировок" {
                description "Сохраняет и получает данные тренировок, GPS-треков, рассчитанных показателей и настроек видимости"
            }
            
            eventPublisher = component "Публикация событий" {
                description "Публикует события о тренировках для других частей системы: ленты, уведомлений и статистики"
            }
        }
        
        socialService = container "Социальный сервис" {
          description "Сервис социальных взаимодействий: подписки, реакции, комментарии. Публикует события для ленты и уведомлений"
        }

        feedService = container "Сервис ленты" {
          description "Сервис формирования ленты активности. Получает события о завершённых тренировках, подписках, лайках и комментариях, формирует read-модель ленты пользователя"
        }

        notificationService = container "Сервис уведомлений" {
          description "Сервис уведомлений. Создаёт историю уведомлений, обрабатывает события активности и социальных взаимодействий, отправляет push-уведомления через FCM/APNS"
        }

        statsService = container "Сервис статистик" {
          description "Сервис статистики и отчётов. Рассчитывает историю тренировок, агрегаты за неделю, месяц и год, сравнение текущего и предыдущего периодов"
        }

        moderationService = container "Сервис модерации" {
          description "Сервис модерации активностей, комментариев и пользователей. Позволяет администраторам скрывать активности и блокировать пользователей"
        }

        integrationService = container "Сервис интеграций" {
          description "Сервис будущих интеграций с фитнес-устройствами и внешними партнёрами. Принимает тренировки из внешних источников и преобразует их в формат системы"
        }

        // ------------------------------------------------------------
        // Инфраструктурные контейнеры
        // ------------------------------------------------------------

        eventBroker = container "Брокер событий" {
          description "Брокер событий для асинхронного взаимодействия между сервисами"
          technology "Kafka / RabbitMQ"
        }

        redisCache = container "Кэш Redis" {
          description "Кэш сессий, access token metadata, часто запрашиваемых профилей, ленты и сводной статистики"
          technology "Redis"
        }

        objectStorage = container "Объектное хранилище" {
          description "Объектное хранилище GPX-файлов и фото пользователей"
          technology "S3 хранилище"
        }

        // ------------------------------------------------------------
        // Хранилища данных
        // Логически разделены по зонам ответственности.
        // Физически на старте могут находиться в одном PostgreSQL-кластере.
        // ------------------------------------------------------------

        authDb = container "БД Авторизации" {
          technology "PostgreSQL"
        }

        userDb = container "БД Профиля" {
          technology "PostgreSQL"
        }

        activityDb = container "БД Активностей" {
          technology "PostgreSQL"
        }

        socialDb = container "БД Социальная" {
          technology "PostgreSQL"
        }

        notificationDb = container "БД Уведомлений" {
          technology "PostgreSQL"
        }

        statsDb = container "БД Статистики" {
          technology "PostgreSQL"
        }

        moderationDb = container "БД Модерации" {
          technology "PostgreSQL schema"
        }
      }
    }

    // ------------------------------------------------------------
    // Связи пользователей с системой
    // ------------------------------------------------------------

    user -> mobileApp "Фиксирует тренировки, смотрит историю, статистику, ленту и уведомления"
    user -> webApp "Просматривает профиль, тренировки, статистику, ленту и социальные взаимодействия"
    admin -> adminApp "Модерирует активности, комментарии и пользователей"
    partner -> apiGateway "Использует партнёрский API для интеграций"

    // ------------------------------------------------------------
    // Связи клиентских приложений
    // ------------------------------------------------------------

    mobileApp -> apiGateway "Вызывает публичный API"
    webApp -> apiGateway "Вызывает публичный API"
    adminApp -> apiGateway "Вызывает административный API"

    mobileApp -> mapServices "Получает карты и отображает GPS-маршруты"
    webApp -> mapServices "Получает карты и отображает маршруты тренировок"

    // ------------------------------------------------------------
    // API Gateway маршрутизирует запросы в доменные сервисы
    // ------------------------------------------------------------

    apiGateway -> authService "Регистрация, вход, выход, проверка токена"
    apiGateway -> userService "Просмотр и редактирование профиля"
    apiGateway -> activityService "Создание, завершение и просмотр активностей"
    apiGateway -> socialService "Подписки, реакции и комментарии"
    apiGateway -> feedService "Получение ленты активности"
    apiGateway -> notificationService "Получение истории уведомлений"
    apiGateway -> statsService "Получение статистики и сравнения прогресса"
    apiGateway -> moderationService "Модерация контента и управление пользователями"
    apiGateway -> integrationService "Импорт тренировок из внешних источников"

    // ------------------------------------------------------------
    // Синхронные связи сервисов с внешними системами
    // ------------------------------------------------------------

    authService -> oauthProviders "Проверяет OAuth-токены и получает подтверждение личности"
    notificationService -> pushServices "Отправляет push-уведомления пользователям"
    notificationService -> emailService "Отправляет email-уведомления и письма восстановления доступа"
    integrationService -> fitnessDevices "Получает данные тренировок из внешних трекеров"

    // ------------------------------------------------------------
    // Сервисные связи с хранилищами
    // ------------------------------------------------------------

    authService -> authDb "Читает и записывает данные авторизации"
    userService -> userDb "Читает и записывает профили пользователей и настройки приватности"
    activityService -> activityDb "Читает и записывает активности, метрики и видимость"
    activityService -> objectStorage "Сохраняет GPX-файлы, GPS-треки и вложения активности"
    socialService -> socialDb "Читает и записывает подписки, реакции и комментарии"
    notificationService -> notificationDb "Читает и записывает историю уведомлений и статусы доставки"
    statsService -> statsDb "Читает и записывает агрегированную статистику тренировок"
    moderationService -> moderationDb "Читает и записывает решения модерации, жалобы и блокировки"

    apiGateway -> redisCache "Проверяет кэш авторизационных данных"
    statsService -> redisCache "Кэширует часто запрашиваемую статистику"

    // ------------------------------------------------------------
    // Публикация событий
    // ------------------------------------------------------------

    authService -> eventBroker
    userService -> eventBroker
    activityService -> eventBroker
    socialService -> eventBroker
    moderationService -> eventBroker
    integrationService -> eventBroker

    // ------------------------------------------------------------
    // Подписка на события
    // ------------------------------------------------------------

    eventBroker -> feedService
    eventBroker -> notificationService
    eventBroker -> statsService
    eventBroker -> moderationService
    eventBroker -> activityService

    // ------------------------------------------------------------
    // Внутренние связи компонентов Activity Service
    // ------------------------------------------------------------

    activityController -> activityManager "Передаёт команды по тренировкам"
    
    activityManager -> trackProcessor "Передаёт GPS-трек или GPX-файл на обработку"
    activityManager -> metricsCalculator "Запрашивает расчёт показателей тренировки"
    activityManager -> activityStorage "Сохраняет и получает данные тренировок"
    activityManager -> eventPublisher "Передаёт событие о создании, завершении или удалении тренировки"
    
    trackProcessor -> activityStorage "Сохраняет обработанный GPS-трек"
    metricsCalculator -> activityStorage "Сохраняет рассчитанные показатели"
    
    activityStorage -> activityDb "Читает и записывает тренировки, GPS-треки, показатели и видимость" "SQL"
    
    eventPublisher -> eventBroker "Публикует события: Активность создана, Активность завершена, Активность удалена" "AsyncAPI"
  }

  views {

    // ------------------------------------------------------------
    // C4 Level 1: System Context
    // ------------------------------------------------------------

    systemContext ritm {
      include *
      autolayout lr
      title "C4 Level 1 — Контекстная диаграмма платформы Ритм"
      description "Показывает пользователей, внешние системы и границы платформы Ритм"
    }

    // ------------------------------------------------------------
    // C4 Level 2: Containers
    // ------------------------------------------------------------

    container ritm {
      include *
      autolayout lr
      title "C4 Level 2 — Диаграмма контейнеров платформы Ритм"
      description "Показывает клиентские приложения, API Gateway, сервисы, брокер событий и хранилища данных"
    }

    // ------------------------------------------------------------
    // C4 Level 3: Components
    // ------------------------------------------------------------

    component activityService {
      include *
      autolayout lr
      title "C4 Level 3 — Диаграмма компонентов Сервис активностей"
      description "Раскрывает внутреннюю структуру сервиса управления тренировками"
    }

    // ------------------------------------------------------------
    // Dynamic view: пример runtime-сценария
    // ------------------------------------------------------------

    // ------------------------------------------------------------
    // Стили
    // ------------------------------------------------------------

    styles {

      element "Person" {
        shape "person"
        background "#facc15"
        color "#000000"
      }

      element "SoftwareSystem" {
        background "#91c9f7"
        color "#000000"
      }

      element "Container" {
        background "#ffffff"
        color "#000000"
        border "solid"
      }

      element "Component" {
        background "#e0f2fe"
        color "#000000"
        border "solid"
      }

      element "Database" {
        shape "cylinder"
        background "#d9f99d"
        color "#000000"
      }

      relationship "default" {
        color "#707070"
      }
    }

    theme default
  }
}